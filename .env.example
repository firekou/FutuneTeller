# 複製為 .env 後依需要修改（.env 已 gitignore）。密鑰只放環境變數，不進前端、不進 repo。
# 模型 provider：claude_cli | anthropic | openai_compatible | none
MINGHENG_PROVIDER=claude_cli
# 選填：指定模型（claude_cli／anthropic 用 Claude 模型 ID）
MINGHENG_MODEL=
# anthropic provider 需要
ANTHROPIC_API_KEY=
# openai_compatible provider 需要：base URL、模型、存放金鑰的環境變數名稱
MINGHENG_OPENAI_BASE_URL=
MINGHENG_OPENAI_KEY_ENV=OPENAI_API_KEY
# 私有資料位置（預設 data/private/，已 gitignore）
MINGHENG_DB=data/private/mingheng.sqlite
MINGHENG_CORPUS=data/private/corpus.jsonl
# Owner 提供的典籍資料夾（不要提交帶簽名的下載 URL）
FORTUNE_SOURCE_FOLDER_URL=
